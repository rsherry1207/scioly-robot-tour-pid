  */
}

// === Movement Command ===
void move(float targetDistance) {
  ticksLeft = 0; ticksRight = 0;
  lastTicksLeft = 0; lastTicksRight = 0;
  distance = 0;
  error = 0; integral = 0; previousError = 0;

  unsigned long lastTime = millis();
  unsigned long stallStartTime = 0;
  bool stalling = false;

  while (true) {
    unsigned long currentTime = millis();
    if (currentTime - lastTime >= loopInterval) {
      float timeDiffSec = (currentTime - lastTime) / 1000.0;

      long currentTicksLeft, currentTicksRight;
      noInterrupts();
      currentTicksLeft = ticksLeft;
      currentTicksRight = ticksRight;
      interrupts();

      long tickDiffLeft = currentTicksLeft - lastTicksLeft;
      long tickDiffRight = currentTicksRight - lastTicksRight;
      lastTicksLeft = currentTicksLeft;
      lastTicksRight = currentTicksRight;

      float ticksPerSecLeft = tickDiffLeft / timeDiffSec;
      float ticksPerSecRight = tickDiffRight / timeDiffSec;
      float revsLeft = ticksPerSecLeft / PPR;
      float revsRight = ticksPerSecRight / PPR;

      float avgRevs = (revsLeft + revsRight) / 2.0;

      if (abs(avgRevs) > 0.001) {
        distance += (wheelDiameter * PI * avgRevs) / 12.0;  // feet
      }

      Serial.print("Distance: ");
      Serial.println(distance);

      error = targetDistance - distance;
      if (abs(error) < 0.01) {
        stopMotors();
        Serial.println("Target reached.");
        return;
      }

      integral += error * timeDiffSec;
      derivative = (error - previousError) / timeDiffSec;
      float output = Kp * error + Ki * integral + Kd * derivative;
      previousError = error;

      int motorOutput = constrain(abs(output * 255), 0, 255);

      if (output > 0) {
        moveForward(motorOutput);
      } else {
        moveBackward(motorOutput);
      }

      // Stall detection
      if (motorOutput < 15) {
        if (!stalling) {
          stalling = true;
          stallStartTime = currentTime;
        } else if (currentTime - stallStartTime > 500) {
          stopMotors();
          Serial.println("Stalled or close enough. Exiting move().");
          return;
        }
      } else {
        stalling = false;
      }

      lastTime = currentTime;
    }
  }
}

// === Motor Control ===
void moveForward(int motorOutput) {
  digitalWrite(in1, HIGH); digitalWrite(in2, LOW); analogWrite(enA, motorOutput);
  digitalWrite(in3, HIGH); digitalWrite(in4, LOW); analogWrite(enB, motorOutput);
}

void moveBackward(int motorOutput) {
  digitalWrite(in1, LOW); digitalWrite(in2, HIGH); analogWrite(enA, motorOutput);
  digitalWrite(in3, LOW); digitalWrite(in4, HIGH); analogWrite(enB, motorOutput);
}

void stopMotors() {
  analogWrite(enA, 0);
  analogWrite(enB, 0);
}

// === Encoder ISRs ===
void encoderLeftISR() {
  if (digitalRead(encA) == digitalRead(encB)) ticksLeft++;
  else ticksLeft--;
}

void encoderRightISR() {
  if (digitalRead(encC) == digitalRead(encD)) ticksRight++;
  else ticksRight--;
}
