// === Motor Pins ===
const int enA = 10;
const int in1 = 9;
const int in2 = 8;

const int enB = 11;
const int in3 = 12;
const int in4 = 13;

// === Encoder Pins ===
const int encA = 2;
const int encB = 3;
const int encC = 4;
const int encD = 7;

// === PID Constants ===
float Kp = 1.3;
float Ki = 0.0;
float Kd = 0.05;

// === PID Variables ===
float error = 0;
float previousError = 0;
float integral = 0;
float derivative = 0;

// === Motion Tracking ===
volatile long ticksLeft = 0;
volatile long ticksRight = 0;
long lastTicksLeft = 0;
long lastTicksRight = 0;
float distance = 0.0;

// === Constants ===
const double wheelDiameter = 2.75;  // inches
const double PPR = 515.0;           // pulses per revolution
const int loopInterval = 20;        // milliseconds

void setup() {
  // Motor setup
  pinMode(enA, OUTPUT); pinMode(in1, OUTPUT); pinMode(in2, OUTPUT);
  pinMode(enB, OUTPUT); pinMode(in3, OUTPUT); pinMode(in4, OUTPUT);

  // Encoder setup
  pinMode(encA, INPUT); pinMode(encB, INPUT);
  pinMode(encC, INPUT); pinMode(encD, INPUT);

  attachInterrupt(digitalPinToInterrupt(encA), encoderLeftISR, RISING);
  attachInterrupt(digitalPinToInterrupt(encC), encoderRightISR, RISING);

  Serial.begin(115200);
}

void loop() {
  /*
  move(12);   // Move forward 12 ft
